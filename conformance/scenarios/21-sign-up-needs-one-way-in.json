{
  "name": "sign-up needs exactly one way in",
  "description": "A sign-up names an Organization to create or an invitation to accept, never both and never neither.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    }
  },
  "steps": [
    {
      "name": "neither is refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "request.invalid"
          }
        }
      }
    },
    {
      "name": "both are refused",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}",
          "organizationName": "Northline",
          "invitationToken": "inv"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": {
            "code": "request.invalid"
          }
        }
      }
    },
    {
      "name": "an invitation nobody issued makes no account",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}",
          "invitationToken": "nobody-issued-this"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_email_verification"
          }
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "core refuses it when the code is verified",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "error": {
            "code": "signup.invitation_invalid"
          }
        }
      }
    },
    {
      "name": "and no account exists",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins",
        "client": "ios",
        "body": {
          "identifier": "{{email}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "needs_password"
          }
        }
      },
      "capture": {
        "signInId": "id",
        "signInSecret": "attemptSecret"
      }
    },
    {
      "name": "so the password opens nothing",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ins/{{signInId}}/password",
        "attempt": "{{signInSecret}}",
        "body": {
          "password": "{{password}}"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "error": {
            "code": "auth.invalid_credentials"
          }
        }
      }
    }
  ]
}
