{
  "name": "sign-up by invitation",
  "description": "A user can join an existing Organization with an invitation token instead of creating one, and every token they get names that Organization and their role.",
  "variables": {
    "email": {
      "generate": "email"
    },
    "password": {
      "generate": "password"
    },
    "invitation": "inv-token-123",
    "organizationId": "org_0123456789abcdef0123456789abcdef"
  },
  "steps": [
    {
      "name": "the Organization invites the address",
      "arrange": {
        "invite": {
          "token": "{{invitation}}",
          "email": "{{email}}",
          "organizationId": "{{organizationId}}",
          "role": "rep"
        }
      }
    },
    {
      "name": "start a sign-up",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups",
        "client": "ios",
        "body": {
          "email": "{{email}}",
          "password": "{{password}}",
          "invitationToken": "{{invitation}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "kind": "sign_up",
          "step": {
            "status": "needs_email_verification"
          }
        }
      },
      "capture": {
        "signUpId": "id",
        "signUpSecret": "attemptSecret"
      }
    },
    {
      "name": "read the emailed code",
      "emailCode": {
        "to": "{{email}}",
        "capture": "code"
      }
    },
    {
      "name": "the right code completes the sign-up in the inviting Organization",
      "request": {
        "method": "POST",
        "path": "/v1/client/sign-ups/{{signUpId}}/verify-email",
        "attempt": "{{signUpSecret}}",
        "body": {
          "code": "{{code}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "step": {
            "status": "complete"
          },
          "session": {
            "organization": {
              "id": "{{organizationId}}",
              "role": "rep"
            }
          }
        }
      },
      "capture": {
        "accessToken": "session.accessToken",
        "userId": "step.userId"
      }
    },
    {
      "name": "the user is a member of that Organization",
      "request": {
        "method": "GET",
        "path": "/v1/client/me",
        "accessToken": "{{accessToken}}"
      },
      "expect": {
        "status": 200,
        "body": {
          "id": "{{userId}}",
          "organization": {
            "id": "{{organizationId}}",
            "role": "rep"
          }
        }
      }
    }
  ]
}
