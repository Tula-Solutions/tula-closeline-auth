# Local values for every environment key (src/env.ts). Copy to .env, which is never committed.
# ENVIRONMENT has no default: a process without it fails at boot.
ENVIRONMENT=local
PORT=3000
LOG_LEVEL=debug
# Longest one readiness check may take, in ms.
READINESS_TIMEOUT_MS=2000
# Longest shutdown waits for in-flight requests before closing them, in ms.
SHUTDOWN_TIMEOUT_MS=10000
# How long /readyz answers 503 before the server stops accepting, in ms. 0 locally.
SHUTDOWN_GRACE_MS=0
# Largest request body accepted, in bytes (1 MB).
MAX_REQUEST_BODY_BYTES=1048576
# The most database connections this instance opens (4 to 100).
DB_POOL_MAX=10
# How often expired sign-in attempts and verification codes are purged, in ms.
RETENTION_INTERVAL_MS=600000
# The most rows one purge statement removes (a run repeats while a batch comes back full).
RETENTION_BATCH_SIZE=500
# The longest one purge run may take, in ms.
RETENTION_RUN_TIMEOUT_MS=30000
# How often the abandon sweep looks for Organizations nobody owns, in ms.
ABANDON_SWEEP_INTERVAL_MS=60000
# Abandon cases one sweep claims at once (the lease grows with it).
ABANDON_SWEEP_BATCH_SIZE=10
# Password hashes or verifications that run at once (each about 64 MiB and 90 ms of a core).
HASH_CONCURRENCY=4
# How many more may wait for a hash slot; past that a request gets a 503 at once.
HASH_QUEUE=16
# Sign-in password verifications that run at once, and how many more may wait. A lane of its
# own, so a flood of sign-ups cannot shed a sign-in.
SIGN_IN_CONCURRENCY=4
SIGN_IN_QUEUE=16
# Breached-password lookups that run at once, and how many more may wait.
BREACH_CHECK_CONCURRENCY=8
BREACH_CHECK_QUEUE=16
# Calls to the core service in flight at once, and how many more may wait (past that: 503 at once).
CORE_CONCURRENCY=64
CORE_QUEUE=256
# The Region this deployment serves (us or eu). No default: a deploy that forgets it fails at boot.
REGION=us
# The closeline_auth login. Optional in local (the compose database); required elsewhere.
DATABASE_URL=postgres://closeline_auth:closeline_auth_local@127.0.0.1:5432/closeline
# 64 hex characters that seal signing keys at rest. Optional in local; required elsewhere. Never
# log it or commit a real one: generate with `openssl rand -hex 32`.
AUTH_MASTER_KEY=
# Where this service is reached: the iss claim of every token. Optional in local.
PUBLIC_URL=http://localhost:3000
# The aud claim of every token; the other services' verifiers expect it.
TOKEN_AUDIENCE=closeline
# The core service's internal routes: an origin (https outside local, no credentials or query) and
# the shared secret it expects as a bearer token (32 or more printable characters; generate with
# `openssl rand -hex 32`; never log or commit a real one). Both are required outside local. In
# local, set both or neither: with neither, a placeholder is used and nobody can sign up.
# CORE_BASE_URL=http://127.0.0.1:3100
# CORE_INTERNAL_TOKEN=
# A local mailbox (Mailpit) that takes sign-up mail, written exactly http://127.0.0.1, http://[::1]
# or http://localhost, with an optional :port. Accepted only when ENVIRONMENT=local; any other
# environment or spelling fails at boot. Leave the line out to unset it: a blank value is refused
# at boot. Unset, the mailer is unconfigured and sign-up answers 503 mail.unavailable.
# MAIL_LOCAL_URL=http://127.0.0.1:8025
# The From address of local mail (default no-reply@closeline.test). Also local only.
# MAIL_LOCAL_FROM=no-reply@closeline.test
# The origins the portal is served from, for the browser client type's refresh and sign-out: a
# comma-separated list (at most 20, no duplicates) of exact origins, https outside local, no
# wildcard, path or trailing slash. Required outside local (boot fails without it). Unset in local,
# every browser refresh and sign-out is refused (auth.forbidden).
# SESSION_ALLOWED_ORIGINS=http://localhost:5173
# Local only, for http development: true drops Secure and the __Secure- prefix from the refresh
# cookie (browsers refuse them on a non-secure origin). Any other environment fails at boot.
# SESSION_COOKIE_INSECURE=true
# Keys for the sign-in counters and the known-device cookie (ADR 0014): 32 to 512 printable
# characters each, different from each other and from every other secret; generate with
# `openssl rand -hex 32`; never log or commit a real one. Both are required outside local, where
# fixed development keys are used. COUNTER_HASH_KEY hashes the counters' keys (rotating it
# restarts every address's guessing budget once); DEVICE_COOKIE_KEY signs the cookie (rotating it
# makes every device unknown until it signs in again).
# COUNTER_HASH_KEY=
# DEVICE_COOKIE_KEY=
# Sign in with Google (ADR 0019): the OAuth client id, client secret and redirect URI, set all three
# or none (a half-set configuration fails at boot; none means off and the routes answer
# oidc.disabled). The secret is never logged. Outside local the redirect URI must be https, on one
# of SESSION_ALLOWED_ORIGINS, and end in /v1/client/google/callback. Register it with Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3002/v1/client/google/callback
# Local only: the issuer of the fake OpenID provider instead of https://accounts.google.com.
# GOOGLE_ISSUER_URL=http://127.0.0.1:4010
# How many proxies in front of this service append to X-Forwarded-For (1 to 10). Default 1 in
# local; REQUIRED outside local (boot fails without it). In production it equals the number of edge proxies in front of auth (1 behind the ALB alone, 2 with
# CloudFront in front of it); every caller takes the same path. The per-source rate limits take the client address from that many hops from the
# right; a header with fewer hops, or none, is refused with request.invalid outside local (in local it shares the 'local' bucket). Nothing the client wrote at
# the front of the header is used.
# TRUSTED_PROXY_HOPS=1
