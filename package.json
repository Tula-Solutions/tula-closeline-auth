{
  "name": "tula-closeline-auth",
  "version": "0.0.0",
  "description": "Closeline auth service: sign-in, sessions and tokens, copied from tula-auth",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare": "husky || true",
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "check": "biome check src bench scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "bench": "bun test bench",
    "test:integration": "bun test --timeout 30000 $(find ./src -name '*.integration.ts' | sort)",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check",
    "shared:check": "bash .claude/hooks/shared-check.sh",
    "verify": "bun run check && bun run typecheck && bun run test:coverage && bun run bench && bun run openapi:check && bun run shared:check",
    "verify:changed": "biome check --changed --no-errors-on-unmatched src bench scripts && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "tula-closeline-contract": "git+ssh://git@github.com/Tula-Solutions/tula-closeline-contract.git#v0.5.0",
    "tula-closeline-db": "git+ssh://git@github.com/Tula-Solutions/tula-closeline-db.git#v0.4.0",
    "tula-closeline-kit": "git+ssh://git@github.com/Tula-Solutions/tula-closeline-kit.git#v0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
